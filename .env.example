# Copy to .env and fill in real values. Never commit .env (already in .gitignore).
# The webhook starts with EITHER provider fully configured (or both); a
# half-filled provider is a startup error.

# ---- Twilio WhatsApp Sandbox (docs/twilio_setup.md) ------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---- Meta WhatsApp Cloud API (docs/meta_whatsapp_setup.md) -----------------
# Access token from the app's WhatsApp > API Setup page. The temporary token
# there expires after about 24 hours -- use a System User token for anything
# longer-lived.
META_ACCESS_TOKEN=your_meta_access_token_here
# "Phone number ID" (a long number) from WhatsApp > API Setup -- not the phone number itself.
META_PHONE_NUMBER_ID=123456789012345
# Any string you make up; type the same value into the webhook's "Verify token" field.
META_VERIFY_TOKEN=choose_a_long_random_string
# Optional but recommended: App settings > Basic > App secret. When set, every
# delivery's X-Hub-Signature-256 is checked and forged requests are refused.
META_APP_SECRET=
# Optional: Graph API version. Defaults to v26.0 if left empty.
META_GRAPH_VERSION=v26.0
